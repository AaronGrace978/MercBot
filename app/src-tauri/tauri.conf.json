{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MercBot Acid Runtime",
  "version": "0.3.2",
  "identifier": "com.aarongrace.mercbot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MERCBOT // ACID-HARNESS FRONTIER AGENT RUNTIME",
        "width": 1480,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true,
        "backgroundColor": "#050c07"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
